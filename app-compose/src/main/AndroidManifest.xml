<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: core's Application/native may probe; matches legacy :app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Legacy storage (maxSdkVersion guards: SAF is the real path on 29+). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Controller rumble (host Activity, SP1-C; declared now so core code never NPEs). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- SP1-B: switch from default Application to core's bootstrap. onCreate now runs:
         the Vulkan GPU probe (ProcessorInfo -> libhardware_ProcessorInfo.so, brings up
         Vulkan to read the device name), first-run asset extraction (default_config.toml +
         profile), and EAGER Emulator.load_library() on non-delay devices (Adreno 830). -->
    <application
        android:name="aenu.ax360e.Application"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ax360eCompose">
        <activity
            android:name="aenu.ax360e.compose.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- SP1-C: the emulator host. Separate :emu process (libe.so is single-shot
             per process; onDestroy -> System.exit(0) hard-kills it cleanly). singleTask
             so a relaunch/pinned-shortcut routes to the existing task instead of
             re-booting. Full configChanges so rotation/keyboard/etc. do NOT recreate the
             Activity (a recreate would re-enter the single-shot boot). Fullscreen theme:
             the Vulkan swapchain must own the whole window. -->
        <activity
            android:name="aenu.ax360e.compose.EmulatorHostActivity"
            android:process=":emu"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.Ax360eEmu">
            <!-- In-app launch: GameLibraryViewModel.buildLaunchIntent (AX360E + setPackage). -->
            <intent-filter>
                <action android:name="aenu.intent.action.AX360E" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Pinned-shortcut cold start: createShortcut sets action = ACTION_VIEW. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
